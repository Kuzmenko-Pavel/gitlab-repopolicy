# Local overrides of Makefile variables. Copy to .env; .env is not committed.

# git used by integration tests: system git or the git bundled with Gitaly.
GIT_BIN=git
# gitlab/gitlab-ce image tag for the e2e stand.
GITLAB_VERSION=19.4.2-ce.0
# Time per fuzz target in test-fuzz.
FUZZTIME=30s
# Previous release (without v) for the rollback check; computed from tags in a release.
COMPAT_PREV_VERSION=
# Local release check: directories with already downloaded archives and checksums.txt.
COMPAT_PREV_DIR=
RELEASE_ASSETS_DIR=
# Start of the commit range for code-lint-commits.
BASE_REF=origin/main
# Version for make release, without v; asked interactively when empty.
RELEASE_VERSION=
