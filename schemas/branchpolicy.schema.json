{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "extends": {
      "description": "Presets of the server config, merged in this order before the file.",
      "oneOf": [
        {
          "pattern": "^[a-z0-9-]{1,63}$",
          "type": "string"
        },
        {
          "items": {
            "pattern": "^[a-z0-9-]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      ],
      "x-repopolicy-check": "extends"
    },
    "mode": {
      "description": "warn turns every denial into a warning; the default is enforce.",
      "enum": [
        "warn",
        "enforce"
      ],
      "type": "string"
    },
    "rules": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "A class of branch names; a new branch takes the matching rule with the lowest priority, a name that matches none is not checked.",
        "properties": {
          "deny": {
            "description": "true: branches of this class may not be created.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "help": {
            "additionalProperties": false,
            "description": "Help printed in the denial of this rule.",
            "properties": {
              "contact": {
                "description": "Who to ask, for example #gitlab-support.",
                "maxLength": 200,
                "type": [
                  "string",
                  "null"
                ],
                "x-repopolicy-check": "help-text"
              },
              "docs_url": {
                "description": "Documentation of the rule, an http(s) URL.",
                "maxLength": 200,
                "pattern": "^https?://",
                "type": [
                  "string",
                  "null"
                ],
                "x-repopolicy-check": "help-url"
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "match": {
            "description": "Required after merging with presets. all or a list of branch names and /regexes/: the names of the class.",
            "oneOf": [
              {
                "enum": [
                  "all"
                ],
                "type": "string"
              },
              {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "x-repopolicy-check": "match"
          },
          "message": {
            "description": "Required after merging with presets. What the pusher reads when the rule denies a push.",
            "maxLength": 1000,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "description": "Required after merging with presets. Order of the rules: the lowest number that matches wins; unique after merging with presets.",
            "maximum": 1000000,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "protected": {
            "description": "true: a new branch of this class must be a protected branch of the GitLab project.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "user_prefix": {
            "description": "true: the part of the name before the first / is the username of an active GitLab user.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": [
          "object",
          "null"
        ],
        "x-repopolicy-check": "rule"
      },
      "description": "Rules by name. A rule of the file with the name of a preset rule overrides its fields; null removes it.",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[a-z0-9-]{1,63}$"
      },
      "type": "object"
    },
    "version": {
      "const": 1,
      "description": "Schema version of the file.",
      "type": "integer"
    }
  },
  "required": [
    "version"
  ],
  "title": "BRANCHPOLICY",
  "type": "object"
}
