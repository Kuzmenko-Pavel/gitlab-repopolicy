{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "extends": {
      "description": "Presets of the server config, merged in this order before the file.",
      "oneOf": [
        {
          "pattern": "^[a-z0-9-]{1,63}$",
          "type": "string"
        },
        {
          "items": {
            "pattern": "^[a-z0-9-]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      ],
      "x-repopolicy-check": "extends"
    },
    "mode": {
      "description": "warn turns every error into a warning; the default is enforce.",
      "enum": [
        "warn",
        "enforce"
      ],
      "type": "string"
    },
    "rules": {
