{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "extends": {
      "description": "Presets of the server config, merged in this order before the file.",
      "oneOf": [
        {
          "pattern": "^[a-z0-9-]{1,63}$",
          "type": "string"
        },
        {
          "items": {
            "pattern": "^[a-z0-9-]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      ],
      "x-repopolicy-check": "extends"
    },
    "mode": {
      "description": "warn turns every error into a warning; the default is enforce.",
      "enum": [
        "warn",
        "enforce"
      ],
      "type": "string"
    },
    "rules": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "Every rule that matches a branch applies (AND).",
        "properties": {
          "checks": {
            "additionalProperties": false,
            "description": "Checks of the messages, by name; null removes a check of a preset.",
            "properties": {
              "body-max-line-length": {
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "error",
                      "warn"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "types": {
                    "description": "Apply the check only to these types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "value": {
                    "description": "Required after merging with presets.",
                    "maximum": 10000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "body-required": {
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "error",
                      "warn"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "types": {
                    "description": "Apply the check only to these types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "breaking-bang": {
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "error",
                      "warn"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "types": {
                    "description": "Apply the check only to these types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "value": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "allow",
                      "forbid"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "header-max-length": {
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "error",
                      "warn"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "types": {
                    "description": "Apply the check only to these types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "value": {
                    "description": "Required after merging with presets.",
                    "maximum": 10000,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "pattern": {
                "additionalProperties": false,
                "properties": {
                  "keys": {
                    "description": "Trailer keys to search, for location: trailer; compared case-insensitively.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "level": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "error",
                      "warn"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "location": {
                    "description": "Required after merging with presets. Where the regex is searched.",
                    "enum": [
                      "header",
                      "body",
                      "trailer",
                      "message"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "types": {
                    "description": "Apply the check only to these types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "value": {
                    "description": "Required after merging with presets. /re/ or /re/i must be found; !/re/ or !/re/i must not be found. RE2, searched anywhere like =~ in GitLab CI.",
                    "minLength": 1,
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-repopolicy-check": "pattern"
                  }
                },
                "type": [
                  "object",
                  "null"
                ],
                "x-repopolicy-check": "pattern-keys"
              },
              "scope": {
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "error",
                      "warn"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "types": {
                    "description": "Apply the check only to these types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "value": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "optional",
                      "required",
                      "forbidden"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "scope-enum": {
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "error",
                      "warn"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "types": {
                    "description": "Apply the check only to these types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "value": {
                    "description": "Required after merging with presets. Allowed scopes.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "subject-case": {
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "error",
                      "warn"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "types": {
                    "description": "Apply the check only to these types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "value": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "lower-first",
                      "sentence",
                      "any"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "subject-full-stop": {
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "error",
                      "warn"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "types": {
                    "description": "Apply the check only to these types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "value": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "forbid",
                      "require"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "trailer-required": {
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "error",
                      "warn"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "types": {
                    "description": "Apply the check only to these types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "value": {
                    "description": "Required after merging with presets. Trailer keys that every message must have.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "type-enum": {
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "description": "Required after merging with presets.",
                    "enum": [
                      "error",
                      "warn"
                    ],
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "types": {
                    "description": "Apply the check only to these types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "value": {
                    "description": "Required after merging with presets. Allowed types.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": [
                      "array",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "except": {
            "additionalProperties": false,
            "properties": {
              "git_reverts": {
                "description": "Skip messages of git revert and of the GitLab revert button.",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "merge_commit": {
                "description": "Skip merge commits.",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "merged_commits": {
                "description": "Check only the first-parent chain: commits that a merge commit brings in are not checked.",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "users": {
                "description": "Usernames whose pushes skip this rule, for example a release bot.",
                "items": {
                  "pattern": "^(?:[a-zA-Z0-9_.][a-zA-Z0-9_.-]{0,254}[a-zA-Z0-9_-]|[a-zA-Z0-9_])$",
                  "type": "string",
                  "x-repopolicy-check": "username"
                },
                "maxItems": 50,
                "type": [
                  "array",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "help": {
            "additionalProperties": false,
            "description": "Help printed in the denial of this rule.",
            "properties": {
              "contact": {
                "description": "Who to ask, for example #gitlab-support.",
                "maxLength": 200,
                "type": [
                  "string",
                  "null"
                ],
                "x-repopolicy-check": "help-text"
              },
              "docs_url": {
                "description": "Documentation of the rule, an http(s) URL.",
                "maxLength": 200,
                "pattern": "^https?://",
                "type": [
                  "string",
                  "null"
                ],
                "x-repopolicy-check": "help-url"
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "match": {
            "description": "Required after merging with presets. all, default or a list of branch names and /regexes/: the branches the rule applies to.",
            "oneOf": [
              {
                "enum": [
                  "all",
                  "default"
                ],
                "type": "string"
              },
              {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "x-repopolicy-check": "match-default"
          },
          "message": {
            "description": "Required after merging with presets. What the pusher reads when the rule denies a push.",
            "maxLength": 1000,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "parser": {
            "description": "Required after merging with presets. conventional: type(scope)!: subject; free: the header is the subject.",
            "enum": [
              "conventional",
              "free"
            ],
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": [
          "object",
          "null"
        ],
        "x-repopolicy-check": "conventional"
      },
      "description": "Rules by name. A rule of the file with the name of a preset rule overrides its fields; null removes it.",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[a-z0-9-]{1,63}$"
      },
      "type": "object"
    },
    "version": {
      "const": 1,
      "description": "Schema version of the file.",
      "type": "integer"
    }
  },
  "required": [
    "version"
  ],
  "title": "COMMITPOLICY",
  "type": "object"
}
