{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admins": {
      "description": "1 to 5 usernames that may change PATHPOLICY itself.",
      "items": {
        "pattern": "^(?:[a-zA-Z0-9_.][a-zA-Z0-9_.-]{0,254}[a-zA-Z0-9_-]|[a-zA-Z0-9_])$",
        "type": "string",
        "x-repopolicy-check": "username"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true,
      "x-repopolicy-check": "usernames"
    },
    "extends": {
      "description": "Presets of the server config, merged in this order before the file.",
      "oneOf": [
        {
          "pattern": "^[a-z0-9-]{1,63}$",
          "type": "string"
        },
        {
          "items": {
            "pattern": "^[a-z0-9-]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      ],
      "x-repopolicy-check": "extends"
    },
    "rules": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "Every rule that matches a path must be satisfied (AND).",
        "properties": {
          "allow": {
            "description": "Required after merging with presets. 1 to 50 usernames that may change the paths; no groups or roles.",
            "items": {
              "pattern": "^(?:[a-zA-Z0-9_.][a-zA-Z0-9_.-]{0,254}[a-zA-Z0-9_-]|[a-zA-Z0-9_])$",
              "type": "string",
              "x-repopolicy-check": "username"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": [
              "array",
              "null"
            ],
            "uniqueItems": true,
            "x-repopolicy-check": "usernames"
          },
          "check_history": {
            "description": "new-content (the default): the commits that no branch or tag has yet, without the content of a path that the branch or the default branch already had; incoming: the net diff of the push and every commit that enters the branch.",
            "enum": [
              "new-content",
              "incoming"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "help": {
            "additionalProperties": false,
            "description": "Help printed in the denial of this rule.",
            "properties": {
              "contact": {
                "description": "Who to ask, for example #gitlab-support.",
                "maxLength": 200,
                "type": [
                  "string",
                  "null"
                ],
                "x-repopolicy-check": "help-text"
              },
              "docs_url": {
                "description": "Documentation of the rule, an http(s) URL.",
                "maxLength": 200,
                "pattern": "^https?://",
                "type": [
                  "string",
                  "null"
                ],
                "x-repopolicy-check": "help-url"
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "match": {
            "description": "Required after merging with presets. all, default or a list of branch names and /regexes/: the branches the rule applies to.",
            "oneOf": [
              {
                "enum": [
                  "all",
                  "default"
                ],
                "type": "string"
              },
              {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "x-repopolicy-check": "match-default"
          },
          "message": {
            "description": "Required after merging with presets. What the pusher reads when the rule denies a push.",
            "maxLength": 1000,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "paths": {
            "description": "Required after merging with presets. 1 to 50 doublestar patterns anchored at the repository root.",
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^/!\\\\{}][^\\\\{}]*$",
              "type": "string",
              "x-repopolicy-check": "path-pattern"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": [
          "object",
          "null"
        ]
      },
      "description": "Rules by name. A rule of the file with the name of a preset rule overrides its fields; null removes it.",
      "maxProperties": 100,
      "propertyNames": {
        "pattern": "^[a-z0-9-]{1,63}$"
      },
      "type": "object"
    },
    "version": {
      "const": 1,
      "description": "Schema version.",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "admins"
  ],
  "title": "PATHPOLICY",
  "type": "object"
}
