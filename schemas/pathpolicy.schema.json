{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admins": {
      "description": "1 to 5 usernames that may change PATHPOLICY itself.",
      "items": {
        "pattern": "^(?:[a-zA-Z0-9_.][a-zA-Z0-9_.-]{0,254}[a-zA-Z0-9_-]|[a-zA-Z0-9_])$",
        "type": "string",
        "x-repopolicy-check": "username"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true,
      "x-repopolicy-check": "usernames"
    },
    "rules": {
      "description": "Path rules; every rule that matches a path must be satisfied (AND).",
      "items": {
        "additionalProperties": false,
        "properties": {
          "allow": {
            "description": "1 to 50 usernames that may change the paths; no groups or roles.",
            "items": {
              "pattern": "^(?:[a-zA-Z0-9_.][a-zA-Z0-9_.-]{0,254}[a-zA-Z0-9_-]|[a-zA-Z0-9_])$",
              "type": "string",
              "x-repopolicy-check": "username"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true,
            "x-repopolicy-check": "usernames"
          },
          "message": {
            "description": "Text shown when a change is denied, up to 1000 characters.",
            "maxLength": 1000,
            "type": "string"
          },
          "name": {
            "pattern": "^[a-z0-9-]{1,63}$",
            "type": "string"
          },
          "paths": {
            "description": "1 to 50 doublestar patterns anchored at the repository root.",
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^/!\\\\{}][^\\\\{}]*$",
              "type": "string",
              "x-repopolicy-check": "path-pattern"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array"
          },
          "refs": {
            "description": "all (default), protected, default or a list of ref patterns such as refs/heads/release/*.",
            "oneOf": [
              {
                "enum": [
                  "all",
                  "default",
                  "protected"
                ],
                "type": "string"
              },
              {
                "items": {
                  "pattern": "^refs/",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            ],
            "x-repopolicy-check": "refs"
          }
        },
        "required": [
          "name",
          "paths",
          "allow"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array",
      "x-repopolicy-check": "unique-names"
    },
    "version": {
      "const": 1,
      "description": "Schema version; version 1 is frozen.",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "admins"
  ],
  "title": "PATHPOLICY",
  "type": "object"
}
