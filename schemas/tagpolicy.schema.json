{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "extends": {
      "description": "Presets of the server config, merged in this order before the file.",
      "oneOf": [
        {
          "pattern": "^[a-z0-9-]{1,63}$",
          "type": "string"
        },
        {
          "items": {
            "pattern": "^[a-z0-9-]{1,63}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      ],
      "x-repopolicy-check": "extends"
    },
    "keys": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string",
        "x-repopolicy-check": "public-key"
      },
      "description": "1 to 32 public keys by label: an armored OpenPGP public key block or an OpenSSH public key on one line. Required when there are rules after merging with presets.",
      "maxProperties": 32,
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]{1,255}$"
      },
      "type": "object",
      "x-repopolicy-check": "distinct-keys"
    },
    "rules": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "Every rule that matches a tag must be satisfied (AND).",
        "properties": {
          "help": {
            "additionalProperties": false,
            "description": "Help printed in the denial of this rule.",
            "properties": {
              "contact": {
                "description": "Who to ask, for example #gitlab-support.",
                "maxLength": 200,
                "type": [
                  "string",
                  "null"
                ],
                "x-repopolicy-check": "help-text"
              },
              "docs_url": {
                "description": "Documentation of the rule, an http(s) URL.",
                "maxLength": 200,
                "pattern": "^https?://",
                "type": [
                  "string",
                  "null"
                ],
                "x-repopolicy-check": "help-url"
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "match": {
            "description": "Required after merging with presets. all or a list of tag names and /regexes/, such as ['/^v\\d+\\.\\d+\\.\\d+$/'].",
            "oneOf": [
              {
                "enum": [
                  "all"
                ],
                "type": "string"
              },
              {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "x-repopolicy-check": "match"
          },
          "message": {
            "description": "Required after merging with presets. What the pusher reads when the rule denies a push.",
            "maxLength": 1000,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "protected": {
            "description": "true: a tag created under this rule must be a protected tag of the GitLab project, so that its pipeline gets protected variables and runners.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "signers": {
            "description": "Required after merging with presets. Labels of keys of the file that may sign the matching tags.",
            "items": {
              "pattern": "^[A-Za-z0-9_.-]{1,255}$",
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "type": [
              "array",
              "null"
            ],
            "uniqueItems": true
          }
        },
        "type": [
          "object",
          "null"
        ]
      },
      "description": "Rules by name. A rule of the file with the name of a preset rule overrides its fields; null removes it.",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[a-z0-9-]{1,63}$"
      },
      "type": "object"
    },
    "version": {
      "const": 1,
      "description": "Schema version.",
      "type": "integer"
    }
  },
  "required": [
    "version"
  ],
  "title": "TAGPOLICY",
  "type": "object"
}
